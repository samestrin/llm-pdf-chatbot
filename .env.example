# Copy to .env and fill in. docker compose passes these to the backend.
# Any OpenAI-compatible endpoint works; leave a value empty to leave it unset.

# --- Local models (for example Ollama on the host) ---
LLM_BASE_URL=http://host.docker.internal:11434/v1
# Local servers usually need no key.
LLM_API_KEY=
LLM_FAST_MODEL=llama3.2
LLM_REASONING_MODEL=qwen3:14b
LLM_EMBEDDING_MODEL=nomic-embed-text

# --- Cloud models (for example OpenAI); replace the block above with this ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_FAST_MODEL=gpt-4o-mini
# LLM_REASONING_MODEL=o4-mini
# LLM_EMBEDDING_MODEL=text-embedding-3-small

# Optional: URL of an OCR service for scanned pages. Empty means no OCR.
OCR_URL=
