# Copy to .env and fill in. docker compose passes these to the backend.
# Any OpenAI-compatible endpoint works; leave a value empty to leave it unset.

# --- Local models (for example Ollama on the host) ---
LLM_BASE_URL=http://host.docker.internal:11434/v1
# Local servers usually need no key.
LLM_API_KEY=
LLM_FAST_MODEL=llama3.2
LLM_REASONING_MODEL=qwen3:14b
LLM_EMBEDDING_MODEL=nomic-embed-text

# --- Cloud models (for example OpenAI); replace the block above with this ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_FAST_MODEL=gpt-4o-mini
# LLM_REASONING_MODEL=o4-mini
# LLM_EMBEDDING_MODEL=text-embedding-3-small

# Optional: seconds to wait for a model call. Empty means 60.
LLM_TIMEOUT_SECONDS=
# Optional: chunks per embedding call. Empty means 64.
EMBED_BATCH_SIZE=

# Optional: URL of an OCR service for scanned pages. Empty means no OCR.
OCR_URL=

# Optional: full URL of a rerank endpoint (Cohere/Jina shape). Empty means the
# fusion order is used as is. The model and key are sent when set. An empty
# timeout means 30 seconds.
RERANK_URL=
RERANK_MODEL=
RERANK_API_KEY=
RERANK_TIMEOUT_SECONDS=

# Optional: questions whose nearest passage has a cosine similarity below this (0 to 1)
# are answered "not in your documents" without asking the model. Empty means 0.3.
REFUSAL_MIN_SIMILARITY=

# Optional: how many earlier turns of the conversation go to the model with each
# question (0 sends none). Empty means 6.
CHAT_HISTORY_TURNS=

# Optional: fast-model prices per million input and output tokens, both or neither.
# Empty means each answer's cost is null (unknown), never 0; set both to 0 for a free
# local model.
LLM_PRICE_FAST_PER_MTOK_IN=
LLM_PRICE_FAST_PER_MTOK_OUT=
