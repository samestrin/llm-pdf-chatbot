# The backend build's context is the repo root (docker-compose.yml,
# docker-compose.proxy.yml) so the image can ship the repo LICENSE. Only what
# backend/Dockerfile copies is needed: LICENSE, backend/pyproject.toml,
# backend/uv.lock and backend/app.
.git
.paperclip
frontend
db
docs
scripts
*.md
backend/.venv
backend/tests
backend/evals
backend/.dockerignore
**/__pycache__
**/*.db
**/.pytest_cache
**/.ruff_cache
