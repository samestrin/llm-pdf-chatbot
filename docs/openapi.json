                }
              ],
              "description": "A preset id from `GET /presets`; `demo` with `X-Demo-Code`.",
              "title": "X-Model-Preset"
            },
            "description": "A preset id from `GET /presets`; `demo` with `X-Demo-Code`."
          },
          {
            "name": "x-model-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The visitor's own key for the preset; never stored or logged.",
              "title": "X-Model-Key"
            },
            "description": "The visitor's own key for the preset; never stored or logged."
          },
          {
            "name": "x-demo-code",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "A demo code, sent to the demo gateway; never stored or logged.",
