  "paths": {
    "/collections/{collection}/documents": {
      "post": {
        "summary": "Upload Document",
        "description": "Upload a PDF into the named collection, creating the collection if it is new, and queue it for ingestion (reading, keyword index, embeddings) in the background, embedded with the request's model preset and key when it sends them. Non-PDF content and PDFs over the page limit return 422; files over the size limit return 413. A collection embedded with another preset or embedding model returns 409. There is no auth and there are no accounts. In a public demo a collection belongs to the browser session that made it: another session's collection or document returns 404, and the shared sample is read-only (403).",
        "operationId": "upload_document_collections__collection__documents_post",
        "parameters": [
          {
            "name": "collection",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "title": "Collection"
            }
          },
          {
            "name": "x-model-preset",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "A preset id from `GET /presets`; `demo` with `X-Demo-Code`.",
              "title": "X-Model-Preset"
            },
            "description": "A preset id from `GET /presets`; `demo` with `X-Demo-Code`."
          },
          {
            "name": "x-model-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The visitor's own key for the preset; never stored or logged.",
              "title": "X-Model-Key"
            },
            "description": "The visitor's own key for the preset; never stored or logged."
          },
          {
            "name": "x-demo-code",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "A demo code, sent to the demo gateway; never stored or logged.",
              "title": "X-Demo-Code"
            },
            "description": "A demo code, sent to the demo gateway; never stored or logged."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_document_collections__collection__documents_post"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Upload Document Collections  Collection  Documents Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/documents/{document_id}/status": {
      "get": {
        "summary": "Document Status",
        "description": "Where a document's ingestion is: its state (`queued`, `processing`, `ready`, or `failed` with the reason), how many pages were read, and, once its pages are read, each page with the method that read it (`text_layer` or `tesseract` from OCR, `pymupdf` from the text layer fallback) and why OCR failed on it, if it did. Pages no method could read are listed under `failures` with the reason. There is no auth and there are no accounts. In a public demo a collection belongs to the browser session that made it: another session's collection or document returns 404, and the shared sample is read-only (403).",
        "operationId": "document_status_documents__document_id__status_get",
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Document Id"
            }
          },
          {
            "name": "x-model-preset",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "A preset id from `GET /presets`; `demo` with `X-Demo-Code`.",
              "title": "X-Model-Preset"
            },
            "description": "A preset id from `GET /presets`; `demo` with `X-Demo-Code`."
          },
          {
            "name": "x-model-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The visitor's own key for the preset; never stored or logged.",
              "title": "X-Model-Key"
            },
            "description": "The visitor's own key for the preset; never stored or logged."
          },
          {
            "name": "x-demo-code",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "A demo code, sent to the demo gateway; never stored or logged.",
              "title": "X-Demo-Code"
            },
            "description": "A demo code, sent to the demo gateway; never stored or logged."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Document Status Documents  Document Id  Status Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/collections": {
      "get": {
        "summary": "List Collections",
        "description": "Every collection by name, each with its documents in upload order. A document has its display file name, page count, size and, under `status`, the same status fields as `GET /documents/{document_id}/status`. Deleting a collection's last document removes the collection, so a listed collection normally has documents. Each collection names the preset and embedding model it was embedded with (null for the server's own model; it is asked only with them) and whether it is `read_only`. There is no auth and there are no accounts. In a public demo a collection belongs to the browser session that made it: another session's collection or document returns 404, and the shared sample is read-only (403).",
        "operationId": "list_collections_collections_get",
        "parameters": [
          {
            "name": "x-model-preset",
            "in": "header",
            "required": false,
