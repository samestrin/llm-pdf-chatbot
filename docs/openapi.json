{
  "openapi": "3.1.0",
  "info": {
    "title": "llm-pdf-chatbot",
    "version": "1.0.1"
  },
  "paths": {
    "/collections/{collection}/documents": {
      "post": {
        "summary": "Upload Document",
        "description": "Upload a PDF into the named collection, creating the collection if it is new, and queue it for ingestion (reading, keyword index, embeddings) in the background. Non-PDF content and PDFs over the page limit return 422; files over the size limit return 413. There is no auth: the app is local and single-user.",
        "operationId": "upload_document_collections__collection__documents_post",
        "parameters": [
          {
            "name": "collection",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "title": "Collection"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_document_collections__collection__documents_post"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Upload Document Collections  Collection  Documents Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/documents/{document_id}/status": {
      "get": {
        "summary": "Document Status",
        "description": "Where a document's ingestion is: its state (`queued`, `processing`, `ready`, or `failed` with the reason), how many pages were read, and, once its pages are read, each page with the method that read it (`text_layer` or `tesseract` from OCR, `pymupdf` from the text layer fallback) and why OCR failed on it, if it did. Pages no method could read are listed under `failures` with the reason. There is no auth: the app is local and single-user.",
        "operationId": "document_status_documents__document_id__status_get",
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Document Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Document Status Documents  Document Id  Status Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/collections": {
      "get": {
        "summary": "List Collections",
        "description": "Every collection by name, each with its documents in upload order. A document has its display file name, page count, size and, under `status`, the same status fields as `GET /documents/{document_id}/status`. Deleting a collection's last document removes the collection, so a listed collection normally has documents. There is no auth: the app is local and single-user.",
        "operationId": "list_collections_collections_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "type": "array",
                  "title": "Response List Collections Collections Get"
                }
              }
            }
          }
        }
      }
    },
    "/documents/{document_id}/pdf": {
      "get": {
        "summary": "Document Pdf",
        "description": "The stored PDF, inline (`application/pdf`, `X-Content-Type-Options: nosniff`), for the browser's PDF viewer. The id is the one the server generated at upload; any other id, path-like or not, returns 404. There is no auth: the app is local and single-user.",
        "operationId": "document_pdf_documents__document_id__pdf_get",
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Document Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/pdf": {}
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/documents/{document_id}/pages/{page}": {
      "get": {
        "summary": "Document Page",
        "description": "One page's stored text (pages count from 1): the exact text that chunk offsets and so citations index into, with the method that read it. A page no method could read has `text` null and the reason in `error`. A page outside the document returns 404; a page the worker has not read yet returns 409. There is no auth: the app is local and single-user.",
        "operationId": "document_page_documents__document_id__pages__page__get",
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Document Id"
            }
          },
          {
            "name": "page",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Page"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Document Page Documents  Document Id  Pages  Page  Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/documents/{document_id}": {
      "delete": {
        "summary": "Delete Document",
        "description": "Delete a document: its stored file, its row, and (by foreign-key cascade) every row derived from it. When it was the last document of its collection, the collection is removed too. There is no auth: the app is local and single-user.",
        "operationId": "delete_document_documents__document_id__delete",
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Document Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/collections/{collection}": {
      "delete": {
        "summary": "Delete Collection",
        "description": "Delete an empty collection by name. A collection that still has documents is never deleted here (409 `collection is not empty`): delete its documents first, and the last delete removes the collection. An unknown name returns 404. There is no auth: the app is local and single-user.",
        "operationId": "delete_collection_collections__collection__delete",
        "parameters": [
          {
            "name": "collection",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "title": "Collection"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "description": "No such collection"
          },
          "409": {
            "description": "Not empty"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/collections/{collection}/chat": {
      "post": {
        "summary": "Answer a question, streamed as NDJSON",
        "operationId": "chat_collections__collection__chat_post",
        "parameters": [
          {
            "name": "collection",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "title": "Collection"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_upload_document_collections__collection__documents_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_document_collections__collection__documents_post"
      },
      "ChatRequest": {
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "title": "Question"
          },
          "mode": {
            "type": "string",
            "enum": [
              "fast",
              "deep"
            ],
            "title": "Mode",
            "default": "fast"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/HistoryTurn"
            },
            "type": "array",
            "title": "History",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "ChatRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HistoryTurn": {
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "title": "Question"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          }
        },
        "type": "object",
        "required": [
          "question",
          "answer"
        ],
        "title": "HistoryTurn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
